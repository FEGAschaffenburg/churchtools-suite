<!-- TEST CHECKLIST -->
<!-- ============================================ -->
<div class="cts-demo-checklist">
    <h3>✅ Test-Checkliste</h3>
    
    <h4>Funktionalität</h4>
    <ul>
        <li>☐ Alle Shortcodes rendern ohne Fehler</li>
        <li>☐ Events werden korrekt angezeigt</li>
        <li>☐ Kalenderfilter funktionieren</li>
        <li>☐ Services werden angezeigt (wo aktiviert)</li>
        <li>☐ Datumsformatierung korrekt</li>
    </ul>
    
    <h4>Layout & Design</h4>
    <ul>
        <li>☐ Responsive Design auf Mobile</li>
        <li>☐ Keine Layout-Breaks</li>
        <li>☐ Farben konsistent</li>
        <li>☐ Schriften lesbar</li>
        <li>☐ Abstände harmonisch</li>
    </ul>
    
    <h4>Performance</h4>
    <ul>
        <li>☐ Ladezeiten akzeptabel</li>
        <li>☐ Keine JavaScript-Fehler</li>
        <li>☐ Keine PHP-Fehler</li>
        <li>☐ CSS wird geladen</li>
    </ul>
    
    <h4>Interaktion</h4>
    <ul>
        <li>☐ Slider autoplay funktioniert</li>
        <li>☐ Carousel Navigation funktioniert</li>
        <li>☐ Countdown zählt korrekt</li>
        <li>☐ Buttons/Links funktionieren</li>
    </ul>
    
    <h4>Edge Cases</h4>
    <ul>
        <li>☐ Keine Events → Empty State</li>
        <li>☐ Sehr lange Titel → Umbruch</li>
        <li>☐ Keine Services → Kein Break</li>
        <li>☐ Ungültige Parameter → Fehlerbehandlung</li>
    </ul>
</div>

